{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session_trust.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Artifact",

      "Read",
      "Glob",
      "Grep",
      "Write(/home/user/football/**)",
      "Edit(/home/user/football/**)",

      "Bash(python3:*)",
      "Bash(python3 *)",

      "Bash(git status:*)",
      "Bash(git status *)",
      "Bash(git log:*)",
      "Bash(git log *)",
      "Bash(git diff:*)",
      "Bash(git diff *)",
      "Bash(git branch:*)",
      "Bash(git branch *)",
      "Bash(git checkout:*)",
      "Bash(git checkout *)",
      "Bash(git add:*)",
      "Bash(git add *)",
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git fetch:*)",
      "Bash(git fetch *)",
      "Bash(git pull:*)",
      "Bash(git pull *)",
      "Bash(git push:*)",
      "Bash(git push *)",

      "Bash(ls:*)",
      "Bash(ls *)",
      "Bash(date:*)",
      "Bash(date *)",
      "Bash(wc:*)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf *)",
      "Bash(git push --force:*)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Read(/home/user/football/.env)",
      "Read(/home/user/football/.env.*)"
    ]
  }
}
